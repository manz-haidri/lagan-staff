# ==============================================================================
# LAGANSTAFF ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Both the Flutter Mobile App and Next.js Admin Dashboard share this Supabase project.
# Copy this file to .env.local (in apps/admin) or use dart-define / .env (in apps/mobile).
# NEVER commit files containing active production secret keys to version control.

# Supabase Project URL (Public)
# Example: https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Publishable / Anon Key (Public)
# Safe to bundle in client-facing applications (protected by PostgreSQL Row Level Security)
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key

# Supabase Service Role Key (CONFIDENTIAL - DO NOT EXPOSE TO CLIENTS)
# Strictly used for administrative server-side actions in Next.js on Vercel
SUPABASE_SERVICE_ROLE_KEY=your_confidential_service_role_key_for_server_only
